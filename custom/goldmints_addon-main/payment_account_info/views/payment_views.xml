<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_tree_inherit_account_info" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.account.info</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="journal_account_code" optional="show"/>
                <field name="journal_account_name" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="view_account_payment_search_inherit_account_info" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.account.info</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            
            <xpath expr="//search" position="inside">
                <filter string="Account Code" name="group_by_account_code" context="{'group_by':'journal_account_code'}"/>
                <filter string="Account Name" name="group_by_account_name" context="{'group_by':'journal_account_name'}"/>
            </xpath>

        </field>
    </record>

</odoo>