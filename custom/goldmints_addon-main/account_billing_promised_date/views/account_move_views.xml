<odoo>
    <record id="view_move_form_inherit_promised_date" model="ir.ui.view">
        <field name="name">account.move.form.inherit.promised_date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="promised_payment_date" string="นัดชำระ" readonly="0" force_save="1" />
            </xpath>
        </field>
    </record>
</odoo>
