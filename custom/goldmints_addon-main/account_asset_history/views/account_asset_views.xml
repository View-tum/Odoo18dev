<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_form_inherit_history" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.history</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_asset_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        invisible="state == 'model'">
                    <field name="history_count" widget="statinfo" string="Asset History"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
