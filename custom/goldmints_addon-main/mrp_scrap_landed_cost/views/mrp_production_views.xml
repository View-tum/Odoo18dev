<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_scrap_cost" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.scrap.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="cost_finalized" widget="boolean_toggle" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
