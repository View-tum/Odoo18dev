<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_scrap_cost" model="ir.ui.view">
        <field name="name">product.template.form.inherit.scrap.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='landed_cost_ok']" position="before">
                <field name="is_scrap_cost" invisible="type != 'service'" />
            </xpath>
        </field>
    </record>
</odoo>
