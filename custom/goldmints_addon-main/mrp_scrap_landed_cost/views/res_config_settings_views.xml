<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp_scrap_landed_cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='process_operations_setting_container']" position="after">
                <block title="Scrap Auto-Allocation" name="scrap_auto_allocation_setting">
                    <setting string="Scrap Landed Cost Service" help="Service product used to auto-allocate scrap loss into Landed Costs.">
                        <field name="mrp_scrap_landed_cost_product_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
