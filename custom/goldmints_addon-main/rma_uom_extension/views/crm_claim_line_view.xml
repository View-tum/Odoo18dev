<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm_claims_ept_form_view_inherit_uom_cost" model="ir.ui.view">
        <field name="name">crm.claims.ept.form.inherit.uom.cost</field>
        <field name="model">crm.claim.ept</field>
        <field name="inherit_id" ref="rma_ept.crm_claims_ept_form_view" />
        <field name="arch" type="xml">
            <!-- Inline List (Tree) in RMA Details page -->
            <xpath expr="//field[@name='claim_line_ids']/list/field[@name='product_id']" position="after">
                <field name="product_uom_id" groups="uom.group_uom"
                       readonly="parent.state not in ['draft']" required="parent.state in ['draft']"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='claim_line_ids']/list/field[@name='quantity']" position="after">
                <field name="total_lot_quantity" string="Lot Qty" readonly="1" optional="show"/>
                <field name="cost_per_piece" readonly="1" force_save="1" optional="show"/>
                <field name="total_lot_cost" string="Lot Cost" readonly="1" optional="show"/>
                <field name="price_unit" optional="show"/>
            </xpath>

            <!-- Inline Form in RMA Details page - add UoM and cost fields -->
            <xpath expr="//field[@name='claim_line_ids']/form//field[@name='quantity']" position="after">
                <field name="product_uom_id" groups="uom.group_uom"
                       readonly="parent.state not in ['draft']" required="parent.state in ['draft']"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="cost_per_piece" readonly="1" force_save="1"/>
                <field name="price_unit"/>
            </xpath>

            <!-- Lot Breakdown Section in Form - add after the last group -->
            <xpath expr="//field[@name='claim_line_ids']/form/group" position="after">
                <separator string="Lot Breakdown (Detailed)"/>
                <field name="lot_line_ids" readonly="parent.state not in ['draft']" nolabel="1">
                    <list editable="bottom">
                        <field name="lot_id" options="{'no_create': True}" domain="[('product_id', '=', parent.product_id)]"/>
                        <field name="quantity"/>
                        <field name="uom_id" options="{'no_create': True}"/>
                        <field name="quantity_in_base_uom" readonly="1" string="Base Qty"/>
                        <field name="unit_cost" readonly="1"/>
                        <field name="subtotal_cost" readonly="1" sum="Total"/>
                    </list>
                </field>
                <group>
                    <field name="total_lot_quantity" readonly="1"/>
                    <field name="total_lot_cost" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
