<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_tax_invoice" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.tax.invoice</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="has_posted_invoice" invisible="1"/>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_print_to_jasper" string="พิมพ์ใบกำกับภาษี" type="object" class="oe_highlight" invisible="state != 'sale' or is_printed == True or has_posted_invoice == False"/>
                    <button name="action_print_to_jasper" string="พิมพ์ใบกำกับภาษี (สำเนา)" type="object" class="btn-secondary" invisible="state != 'sale' or is_printed == False or has_posted_invoice == False"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>