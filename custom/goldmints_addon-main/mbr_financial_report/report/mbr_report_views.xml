<odoo>
    <data>

    <template id="mbr_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="mbr" t-value="wizard.compute_mbr()"/>
                <t t-set="dataset" t-value="mbr.get('main') or mbr"/>
                <t t-set="file_name" t-value="(dict(wizard._fields['month'].selection).get(wizard.month, 'MBR')) + ' MBR'"/>
                <t t-set="file_name_url" t-value="(file_name or '').replace(' ', '%20')"/>
                <div class="o_mbr_report">
                    <table style="width:100%; font-size:12px; margin-bottom:6px;">
                        <tr>
                            <td style="background:#d9e2f3; font-weight:bold; padding:4px;" colspan="4">
                                <t t-esc="wizard.company_id.name"/> - MBR
                            </td>
                            <td style="background:#d9e2f3; padding:4px;" colspan="3">
                                Scale / Currency
                            </td>
                            <td style="background:#d9e2f3; padding:4px;" colspan="4">
                                Divided by <t t-esc="dataset.get('scale') or 1"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:center; font-weight:bold; font-size:14px;" colspan="11">
                                <t t-esc="dataset.get('period_label')"/>
                            </td>
                        </tr>
                    </table>
                    <div style="text-align:center; margin-bottom:10px;">
                        <a t-attf-href="/report/xlsx/mbr_financial_report.mbr_report_xlsx/{{wizard.id}}?context={%22report_file%22:%22{{file_name_url}}%22}" class="btn btn-primary">
                            Export XLSX
                        </a>
                        <a href="javascript:window.history.back()" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>

                    <table class="table table-sm table-bordered" style="width:100%; font-size:11px;">
                        <thead>
                            <tr>
                                <th rowspan="2">Code / Description</th>
                                <th colspan="6" style="text-align:center;">
                                    <t t-esc="dataset.get('current_label')"/>
                                </th>
                                <th colspan="6" style="text-align:center;">
                                    <t t-esc="dataset.get('ytd_label')"/>
                                </th>
                            </tr>
                            <tr>
                                <th style="text-align:right;">Actual</th>
                                <th style="text-align:right;">%</th>
                                <th style="text-align:right;">Budget</th>
                                <th style="text-align:right;">%</th>
                                <th style="text-align:right;">Difference</th>
                                <th style="text-align:right;">%</th>
                                <th style="text-align:right;">Actual</th>
                                <th style="text-align:right;">%</th>
                                <th style="text-align:right;">Budget</th>
                                <th style="text-align:right;">%</th>
                                <th style="text-align:right;">Difference</th>
                                <th style="text-align:right;">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="13"><strong>1. Revenue</strong></td>
                            </tr>
                            <t t-foreach="[l for l in dataset['lines'] if l['section']=='revenue']" t-as="line">
                                <tr>
                                    <td><t t-esc="('%s %s' % (line['code'], line['name'])).strip()"/></td>
                                    <td class="text-right"><t t-esc="'{:,.0f}'.format(line['curr_actual'] or 0)"/></td>
                                    <td class="text-right"><t t-esc="str(round((line['curr_pct_revenue'] or 0)*100, 1)) + '%'"/></td>
                                    <td class="text-right"><t t-esc="'{:,.0f}'.format(line['curr_budget'] or 0)"/></td>
                                    <td class="text-right"><t t-esc="str(round((line['curr_budget_pct_revenue'] or 0)*100, 1)) + '%'"/></td>
                                    <td class="text-right"><t t-esc="'{:,.0f}'.format(line['curr_diff'] or 0)"/></td>
                                    <td class="text-right"><t t-esc="str(round((line['curr_diff_pct'] or 0)*100, 1)) + '%'"/></td>
                                    <td class="text-right"><t t-esc="'{:,.0f}'.format(line['ytd_actual'] or 0)"/></td>
                                    <td class="text-right"><t t-esc="str(round((line['ytd_pct_revenue'] or 0)*100, 1)) + '%'"/></td>
