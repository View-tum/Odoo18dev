<odoo>
    <record id="view_mbr_account_map_tree" model="ir.ui.view">
        <field name="name">mbr.account.map.tree</field>
        <field name="model">mbr.account.map</field>
        <field name="arch" type="xml">
            <list string="MBR Account Mapping">
                <field name="company_id"/>
                <field name="line_code"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="view_mbr_account_map_form" model="ir.ui.view">
        <field name="name">mbr.account.map.form</field>
        <field name="model">mbr.account.map</field>
        <field name="arch" type="xml">
            <form string="MBR Account Mapping">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="line_code"/>
                        <field name="account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mbr_account_map" model="ir.actions.act_window">
        <field name="name">MBR Account Mapping</field>
        <field name="res_model">mbr.account.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mbr_account_map"
              name="Account Mapping"
              parent="account.account_reports_management_menu"
              action="action_mbr_account_map"
    />
</odoo>