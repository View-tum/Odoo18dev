<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_quick_create" model="ir.ui.view">
        <field name="name">res.users.form.quick.create</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Quick Create" name="quick_create_settings" col="4">
                    <field name="allow_quick_create" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
