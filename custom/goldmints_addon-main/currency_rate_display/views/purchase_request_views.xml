<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_currency_rate_display" model="ir.ui.view">
        <field name="name">purchase.request.form.currency.rate.display</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@class='oe_subtotal_footer oe_right']//field[@name='estimated_cost']" position="after">
                <field name="show_currency_rate" invisible="1"/>
                <label for="currency_rate_display" string="Exchange Rate" invisible="not show_currency_rate"/>
                <div invisible="not show_currency_rate">
                    <field name="currency_id" widget="many2one" readonly="1" nolabel="1" class="d-inline" options="{'no_create': True}"/>
                    <field name="currency_rate_display" nolabel="1" class="d-inline ms-1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
