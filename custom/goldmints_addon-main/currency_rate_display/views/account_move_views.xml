<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_currency_rate_display" model="ir.ui.view">
        <field name="name">account.move.form.currency.rate.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='in_and_refresh_button_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='currency_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="show_currency_rate" invisible="1"/>
                <label for="currency_rate_display" string="Exchange Rate" invisible="not show_currency_rate"/>
                <div invisible="not show_currency_rate">
                    <field name="currency_id" widget="many2one" readonly="1" nolabel="1" class="d-inline" options="{'no_create': True}"/>
                    <field name="currency_rate_display" nolabel="1" class="d-inline ms-1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
