<odoo>
    <record id="view_product_movement_dashboard_batch_tree" model="ir.ui.view">
        <field name="name">product.movement.dashboard.batch.tree</field>
        <field name="model">product.movement.dashboard.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="product_count"/>
                <field name="line_count"/>
                <field name="below_min_count"/>
                <field name="above_max_count"/>
                <field name="total_on_hand_qty"/>
            </list>
        </field>
    </record>

    <record id="view_product_movement_dashboard_batch_form" model="ir.ui.view">
        <field name="name">product.movement.dashboard.batch.form</field>
        <field name="model">product.movement.dashboard.batch</field>
        <field name="arch" type="xml">
            <form string="Product Movement Dashboard">
                <header>
                    <button name="action_generate_lines" type="object" string="Generate Lines" class="btn-primary"/>
                    <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                    <button name="action_open_lines_tree" type="object" string="Open Tree" invisible="line_count == 0"/>
                    <button name="action_open_lines_pivot" type="object" string="Open Pivot" invisible="line_count == 0"/>
                    <button name="action_open_lines_graph" type="object" string="Open Graph" invisible="line_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_lines_tree" icon="fa-cube" invisible="line_count == 0">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_lines_tree" icon="fa-list" invisible="line_count == 0">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_below_min_lines" icon="fa-arrow-down" invisible="below_min_count == 0">
                            <field name="below_min_count" widget="statinfo" string="Below Min"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_above_max_lines" icon="fa-arrow-up" invisible="above_max_count == 0">
                            <field name="above_max_count" widget="statinfo" string="Above Max"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_lines_graph" icon="fa-bar-chart" invisible="line_count == 0">
                            <field name="report_group_count" widget="statinfo" string="Groups"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="product_count" readonly="1"/>
                            <field name="report_group_count" readonly="1"/>
                            <field name="below_min_count" readonly="1"/>
                            <field name="above_max_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Summary Totals" col="6">
                        <field name="total_produced_qty" readonly="1"/>
                        <field name="total_received_qty" readonly="1"/>
                        <field name="total_issued_qty" readonly="1"/>
                        <field name="total_net_movement_qty" readonly="1"/>
                        <field name="total_on_hand_qty" readonly="1"/>
                        <field name="total_shortage_qty" readonly="1"/>
                        <field name="total_excess_qty" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <button name="action_open_stock_moves" type="object" icon="fa-exchange" title="Stock Moves"/>
                                    <button name="action_open_production_moves" type="object" icon="fa-industry" title="Production Moves"/>
                                    <button name="action_open_reordering_rules" type="object" icon="fa-sliders" title="Reordering Rules"/>
                                    <field name="warehouse_id"/>
                                    <field name="report_group_id"/>
                                    <field name="product_id"/>
                                    <field name="default_code"/>
                                    <field name="manufacturing_type"/>
                                    <field name="produced_qty"/>
                                    <field name="received_qty"/>
                                    <field name="issued_qty"/>
                                    <field name="net_movement_qty"/>
                                    <field name="on_hand_qty"/>
                                    <field name="min_qty"/>
                                    <field name="max_qty"/>
                                    <field name="below_min"/>
                                    <field name="above_max"/>
                                    <field name="shortage_qty"/>
                                    <field name="excess_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_movement_dashboard_line_tree" model="ir.ui.view">
        <field name="name">product.movement.dashboard.line.tree</field>
        <field name="model">product.movement.dashboard.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <button name="action_open_stock_moves" type="object" icon="fa-exchange" title="Stock Moves"/>
                <button name="action_open_production_moves" type="object" icon="fa-industry" title="Production Moves"/>
                <button name="action_open_reordering_rules" type="object" icon="fa-sliders" title="Reordering Rules"/>
                <button name="action_open_product" type="object" icon="fa-external-link" title="Product"/>
                <field name="batch_id"/>
                <field name="warehouse_id"/>
                <field name="report_group_id"/>
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <field name="manufacturing_type"/>
                <field name="produced_qty"/>
                <field name="received_qty"/>
                <field name="issued_qty"/>
                <field name="net_movement_qty"/>
                <field name="on_hand_qty"/>
                <field name="min_qty"/>
                <field name="max_qty"/>
                <field name="below_min"/>
                <field name="above_max"/>
                <field name="shortage_qty"/>
                <field name="excess_qty"/>
            </list>
        </field>
    </record>

    <record id="view_product_movement_dashboard_line_form" model="ir.ui.view">
        <field name="name">product.movement.dashboard.line.form</field>
        <field name="model">product.movement.dashboard.line</field>
        <field name="arch" type="xml">
            <form string="Product Movement Line" create="0" delete="0">
                <header>
                    <button name="action_open_product" type="object" string="Open Product"/>
                    <button name="action_open_stock_moves" type="object" string="Stock Moves"/>
                    <button name="action_open_production_moves" type="object" string="Production Moves"/>
                    <button name="action_open_reordering_rules" type="object" string="Reordering Rules"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="report_group_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="default_code" readonly="1"/>
                            <field name="categ_id" readonly="1"/>
                            <field name="manufacturing_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="produced_qty" readonly="1"/>
                            <field name="received_qty" readonly="1"/>
                            <field name="issued_qty" readonly="1"/>
                            <field name="net_movement_qty" readonly="1"/>
                            <field name="on_hand_qty" readonly="1"/>
                            <field name="min_qty" readonly="1"/>
                            <field name="max_qty" readonly="1"/>
                            <field name="shortage_qty" readonly="1"/>
                            <field name="excess_qty" readonly="1"/>
                            <field name="below_min" readonly="1"/>
                            <field name="above_max" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_movement_dashboard_line_search" model="ir.ui.view">
        <field name="name">product.movement.dashboard.line.search</field>
        <field name="model">product.movement.dashboard.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_id"/>
                <field name="warehouse_id"/>
                <field name="report_group_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="manufacturing_type"/>
                <filter string="Below Min" name="below_min" domain="[('below_min', '=', True)]"/>
                <filter string="Above Max" name="above_max" domain="[('above_max', '=', True)]"/>
                <filter string="Has Min/Max" name="has_minmax" domain="['|', ('min_qty', '>', 0), ('max_qty', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Report Group" name="group_by_report_group" context="{'group_by': 'report_group_id'}"/>
                    <filter string="Warehouse" name="group_by_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'categ_id'}"/>
                    <filter string="Manufacturing Type" name="group_by_type" context="{'group_by': 'manufacturing_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_movement_dashboard_line_pivot" model="ir.ui.view">
        <field name="name">product.movement.dashboard.line.pivot</field>
        <field name="model">product.movement.dashboard.line</field>
        <field name="arch" type="xml">
            <pivot string="Product Movement Dashboard" disable_linking="false">
                <field name="report_group_id" type="row"/>
                <field name="warehouse_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="produced_qty" type="measure"/>
                <field name="received_qty" type="measure"/>
                <field name="issued_qty" type="measure"/>
                <field name="net_movement_qty" type="measure"/>
                <field name="on_hand_qty" type="measure"/>
                <field name="min_qty" type="measure"/>
                <field name="max_qty" type="measure"/>
                <field name="shortage_qty" type="measure"/>
                <field name="excess_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_product_movement_dashboard_line_graph" model="ir.ui.view">
        <field name="name">product.movement.dashboard.line.graph</field>
        <field name="model">product.movement.dashboard.line</field>
        <field name="arch" type="xml">
            <graph string="Product Movement Dashboard" type="bar" stacked="True">
                <field name="report_group_id"/>
                <field name="produced_qty" type="measure"/>
                <field name="received_qty" type="measure"/>
                <field name="issued_qty" type="measure"/>
                <field name="on_hand_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_product_movement_dashboard_batch" model="ir.actions.act_window">
        <field name="name">Product Movement Dashboard</field>
        <field name="res_model">product.movement.dashboard.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_product_movement_dashboard"
        name="Product Movement Dashboard"
        parent="mrp.menu_mrp_reporting"
        action="action_product_movement_dashboard_batch"
        sequence="90"
        groups="mrp.group_mrp_user"
    />
</odoo>
