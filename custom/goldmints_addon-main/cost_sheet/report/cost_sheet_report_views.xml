<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat: Cost Sheet A4 Portrait -->
    <record id="paperformat_cost_sheet_a4" model="report.paperformat">
        <field name="name">Cost Sheet A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- QWeb Report Action -->
    <record id="action_report_cost_sheet" model="ir.actions.report">
        <field name="name">Cost Sheet</field>
        <field name="model">cost.sheet.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cost_sheet.report_cost_sheet</field>
        <field name="report_file">cost_sheet.report_cost_sheet</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="paperformat_id" ref="cost_sheet.paperformat_cost_sheet_a4"/>
    </record>

    <!-- XLSX Report Action -->
    <record id="action_report_cost_sheet_xlsx" model="ir.actions.report">
        <field name="name">Cost Sheet Excel</field>
        <field name="model">cost.sheet.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">cost_sheet.report_cost_sheet_xlsx</field>
        <field name="report_file">cost_sheet.report_cost_sheet_xlsx</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="binding_model_id" ref="model_cost_sheet_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_cost_sheet" name="Cost Sheet" t-name="cost_sheet.report_cost_sheet">
        <t t-call="web.basic_layout">

            <!-- payload จาก AbstractModel -->
            <t t-set="data"   t-value="payload or {}"/>
            <t t-set="sheets" t-value="data.get('sheets', [])"/>

            <!-- วนทีละ sheet = 1 landed cost -->
            <t t-foreach="sheets" t-as="sheet">

                <!-- Page break ก่อน sheet ถัดไป (ยกเว้น sheet แรก) -->
                <div t-if="sheet_index > 0" class="page-break"/>

                <!-- ══════════════════════════════════════
                     TITLE
                ══════════════════════════════════════ -->
                <h1 class="cs-title">COST SHEET</h1>

                <!-- ══════════════════════════════════════
                     HEADER INFO
                ══════════════════════════════════════ -->
                <div class="cs-info-container">
                    <table class="cs-meta">
                        <tr>
                            <td class="label">Company:</td>
                            <td class="value"><t t-esc="sheet.get('company') or ''"/></td>
                        </tr>
                        <tr>
                            <td class="label">Period:</td>
                            <td class="value">
                                <t t-esc="sheet.get('date_from')"/>&#160;–&#160;<t t-esc="sheet.get('date_to')"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="label">Landed Cost:</td>
                            <td class="value">
                                <t t-esc="sheet.get('title') or ''"/>
                                <t t-if="sheet.get('lc_date')">&#160;(<t t-esc="sheet.get('lc_date')"/>)</t>
                            </td>
                        </tr>
                        <t t-if="sheet.get('vendor')">
                            <tr>
                                <td class="label">Vendor:</td>
                                <td class="value"><t t-esc="sheet.get('vendor')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('vendor_bill')">
                            <tr>
                                <td class="label">Vendor Bill:</td>
                                <td class="value"><t t-esc="sheet.get('vendor_bill')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('journal_entry')">
                            <tr>
                                <td class="label">Journal Entry:</td>
                                <td class="value"><t t-esc="sheet.get('journal_entry')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('journal')">
                            <tr>
                                <td class="label">Journal:</td>
                                <td class="value"><t t-esc="sheet.get('journal')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('pickings')">
                            <tr>
                                <td class="label">Transfers:</td>
                                <td class="value"><t t-esc="sheet.get('pickings')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('transfer_journal_entry')">
                            <tr>
                                <td class="label">Transfer Journal Entry:</td>
                                <td class="value"><t t-esc="sheet.get('transfer_journal_entry')"/></td>
                            </tr>
                        </t>
                        <t t-if="sheet.get('transfer_journal')">
                            <tr>
                                <td class="label">Transfer Journal:</td>
                                <td class="value"><t t-esc="sheet.get('transfer_journal')"/></td>
                            </tr>
                        </t>
                    </table>
                </div>

                <!-- ══════════════════════════════════════
                     DESCRIPTION (optional)
                ══════════════════════════════════════ -->
                <t t-if="sheet.get('description')">
                    <div class="cs-description-box">
                        <span class="label">Description:</span>
                        <span class="value">
                            <t t-esc="sheet.get('description')"/>
                        </span>
                    </div>
                </t>

                <!-- ══════════════════════════════════════
                     TABLE 1: Cost Components
                ══════════════════════════════════════ -->
                <h4 class="cs-section-title">Cost Components</h4>
                <div class="cs-table-container">
                    <table class="cs-table">
                        <thead>
                            <tr>
                                <th style="width: 70%; text-align: left;">Item</th>
                                <th class="text-right" style="width: 30%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="sheet.get('lines', [])" t-as="line">
                                <tr>
                                    <td><t t-esc="line.get('name')"/></td>
                                    <td class="text-right cs-amount">
                                        <t t-esc="money(line.get('amount') or 0.0)"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Total Landed Cost -->
                            <tr class="cs-total-row">
                                <td class="text-right">Total Landed Cost</td>
                                <td class="text-right cs-amount">
                                    <t t-esc="money(sheet.get('total') or 0.0)"/>
                                </td>
                            </tr>

                            <!-- Total Quantity -->
                            <tr class="cs-summary-row">
                                <td class="text-right">Total Quantity</td>
                                <td class="text-right cs-amount">
                                    <t t-esc="sheet.get('qty_total') or 0.0"/>
                                </td>
                            </tr>

                            <!-- Total Goods -->
                            <tr class="cs-summary-row">
                                <td class="text-right">Total Goods</td>
                                <td class="text-right cs-amount">
                                    <t t-esc="money(sheet.get('total_goods') or 0.0)"/>
                                </td>
                            </tr>

                            <!-- Total Shipment Cost -->
                            <tr class="cs-summary-row">
                                <td class="text-right">Total Shipment Cost</td>
                                <td class="text-right cs-amount">
                                    <t t-esc="money(sheet.get('total_shipment_cost') or 0.0)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- ══════════════════════════════════════
                     TABLE 2: Allocation by Product
                ══════════════════════════════════════ -->
                <t t-if="sheet.get('product_lines')">
                    <h4 class="cs-section-title">Allocation by Product</h4>
                    <div class="cs-table-container">
                        <table class="cs-table cs-product-table">
                            <thead>
                                <tr>
                                    <th style="width: 25%; text-align: left;">Product</th>
                                    <th class="text-right" style="width: 10%;">Quantity</th>
                                    <th class="text-right" style="width: 13%;">Additional Cost</th>
                                    <th class="text-right" style="width: 13%;">Final Cost</th>
                                    <th class="text-right" style="width: 13%;">Unit Cost</th>
                                    <th class="text-right" style="width: 13%;">Add. Cost / Unit</th>
                                    <th class="text-right" style="width: 13%;">Final Cost / Unit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sheet.get('product_lines')" t-as="pline">
                                    <tr>
                                        <td><t t-esc="pline.get('name')"/></td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="pline.get('qty') or 0.0"/>
                                        </td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="money(pline.get('additional') or 0.0)"/>
                                        </td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="money(pline.get('final') or 0.0)"/>
                                        </td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="money(pline.get('unit_cost') or 0.0)"/>
                                        </td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="money(pline.get('unit_cost_add') or 0.0)"/>
                                        </td>
                                        <td class="text-right cs-amount">
                                            <t t-esc="money(pline.get('unit_cost_final') or 0.0)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

            </t> <!-- /t-foreach sheets -->

        </t>
    </template>
</odoo>