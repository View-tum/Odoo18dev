<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_employee_cost_analysis_tree" model="ir.ui.view">
        <field name="name">mrp.employee.cost.analysis.tree</field>
        <field name="model">mrp.employee.cost.analysis</field>
        <field name="arch" type="xml">
            <list string="Employee Cost Analysis (Merged)" create="0" delete="0">
                <field name="date" />
                <field name="employee_id" />
                <field name="workcenter_id" />
                <field name="operation_id" />
                <field name="total_hours" widget="float_time" sum="Total Hours" />
                <field name="total_cost" widget="monetary"
                    options="{'currency_field': 'currency_id'}" sum="Total Cost" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="mrp_employee_cost_analysis_pivot" model="ir.ui.view">
        <field name="name">mrp.employee.cost.analysis.pivot</field>
        <field name="model">mrp.employee.cost.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Employee Cost Analysis" sample="1">
                <field name="employee_id" type="row" />
                <field name="workcenter_id" type="row" />
                <field name="date" type="col" interval="month" />
                <field name="total_hours" type="measure" widget="float_time" />
                <field name="total_cost" type="measure" widget="monetary" />
            </pivot>
        </field>
    </record>

    <record id="mrp_employee_cost_analysis_search" model="ir.ui.view">
        <field name="name">mrp.employee.cost.analysis.search</field>
        <field name="model">mrp.employee.cost.analysis</field>
        <field name="arch" type="xml">
            <search string="Employee Cost Analysis">
                <field name="employee_id" />
                <separator />
                <filter string="Today" name="today"
                    domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter string="This Month" name="this_month"
                    domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]" />
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee"
                        context="{'group_by': 'employee_id'}" />
                    <filter string="Work Center" name="group_by_workcenter"
                        context="{'group_by': 'workcenter_id'}" />
                    <filter string="Operation" name="group_by_operation"
                        context="{'group_by': 'operation_id'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_employee_cost_analysis_action" model="ir.actions.act_window">
        <field name="name">Employee Cost Analysis</field>
        <field name="res_model">mrp.employee.cost.analysis</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="mrp_employee_cost_analysis_search" />
        <field name="context">{'search_default_group_by_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cost data found.
            </p>
            <p>
                This report calculates the unique clocked-in time for each employee by merging
                overlapping productivity logs across all Manufacturing Orders.
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_reporting_employee_cost"
        name="Employee Cost Analysis"
        parent="mrp.menu_mrp_reporting"
        action="mrp_employee_cost_analysis_action"
        sequence="20" />

    <!-- Also add to our Shopfloor Reporting menu if exists, but parallel console follows core
    Reporting structure usually -->
</odoo>
