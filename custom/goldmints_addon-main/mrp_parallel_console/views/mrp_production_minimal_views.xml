<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_minimal_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.minimal</field>
        <field name="model">mrp.production</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Production Components" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="move_raw_ids"
                                widget="stock_move_one2many"
                                context="{'default_date': date_start, 'default_date_deadline': date_start, 'default_location_id': location_src_id, 'default_location_dest_id': production_location_id, 'default_warehouse_id': warehouse_id, 'default_state': 'draft', 'default_raw_material_production_id': id, 'default_picking_type_id': picking_type_id, 'default_company_id': company_id, 'form_view_ref': 'mrp.view_mrp_stock_move_operations', 'active_mo_id': id}"
                                readonly="state == 'cancel' or (state == 'done' and is_locked)">
                                <list default_order="is_done, manual_consumption desc, sequence" editable="bottom">
                                    <control>
                                        <create string="Add a line"/>
                                    </control>
                                    <field name="product_id" force_save="1" required="1" readonly="move_lines_count &gt; 0 or state == 'cancel' or (state != 'draft' and not additional)"/>
                                    <field name="location_id" string="From" readonly="1" force_save="1" groups="stock.group_stock_multi_locations" optional="show"/>
                                    <field name="product_uom_qty" widget="mrp_should_consume" force_save="1" string="To Consume" readonly="state != 'draft'" optional="show"/>
                                    <field name="quantity" string="Quantity" force_save="1" readonly="has_tracking != 'none'"/>
                                    <field name="product_uom" readonly="1" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                                    <field name="picked" string="Consumed" optional="show"/>
                                    <field name="lot_ids" widget="many2many_tags"
                                        optional="show"
                                        string="Lot/Serial Numbers"
                                        groups="stock.group_production_lot"
                                        readonly="1"
                                        context="{'default_product_id': product_id}"
                                        domain="[('product_id','=',product_id)]"/>
                                    <field name="has_tracking" column_invisible="True"/>
                                    <field name="move_lines_count" column_invisible="True"/>
                                    <field name="state" column_invisible="True"/>
                                    <field name="is_done" column_invisible="True"/>
                                    <field name="additional" column_invisible="True"/>
                                    <field name="manual_consumption" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <!-- Invisible fields required for context or logic -->
                    <field name="date_start" invisible="1"/>
                    <field name="location_src_id" invisible="1"/>
                    <field name="production_location_id" invisible="1"/>
                    <field name="warehouse_id" invisible="1"/>
                    <field name="picking_type_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_production_minimal" model="ir.actions.act_window">
        <field name="name">Production Components</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_production_minimal_form_view"/>
        <field name="target">new</field>
    </record>
</odoo>
