<odoo>
    <record id="view_purchase_order_status_report_wizard" model="ir.ui.view">
        <field name="name">purchase.order.status.report.wizard.form</field>
        <field name="model">purchase.order.status.report.wizard</field>
        <field name="arch" type="xml">
            <form string="รายงานสถานะใบสั่งซื้อ">
                <header>
                    <button name="button_preview" string="Preview" type="object" class="btn-info"/>
                    <button name="button_export_pdf" string="Export PDF" type="object" class="btn-secondary"/>
                    <button name="button_export_xlsx" string="Export XLSX" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id" string="ผู้ขาย"/>
                            <field name="product_id" string="สินค้า"/>
                        </group>
                        <group>
                            <field name="date_from" string="วันที่เริ่มต้น"/>
                            <field name="date_to" string="วันที่สิ้นสุด"/>
                            <field name="state" string="สถานะใบสั่งซื้อ"/>
                            <field name="billing_note_status" string="สถานะการวางบิล"/>
                            <field name="invoice_status" string="สถานะการตั้งหนี้"/>
                        </group>
                    </group>
                    


                    <notebook>
                        <page string="Preview Data" invisible="not line_ids">
                            <field name="line_ids">
                                <list string="Report Lines" class="custom_report_table" editable="bottom" create="false" delete="false"
                                      decoration-warning="is_pending"
                                      decoration-bf="is_header or (is_billable and not is_already_billed)"
                                      decoration-muted="is_already_billed">
                                    <field name="is_pending" column_invisible="1"/>
                                    <field name="is_header" column_invisible="1"/>
                                    <field name="is_billable" column_invisible="1"/>
                                    <field name="is_already_billed" column_invisible="1"/>
                                    
                                    <field name="is_selected" string=" " readonly="not is_billable"/>
                                    <field name="order_id" string="ใบสั่งซื้อ" readonly="1"/>
                                    <field name="source_document" readonly="1"/>
                                    <field name="receipt_ref" string="ใบรับสินค้า/บริการ (SA/Receipt)" readonly="1"/>
                                    <field name="receipt_date" readonly="1"/>
                                    <field name="inv_ref" string="เลขที่ใบแจ้งหนี้ (Inv Ref)" readonly="1"/>
                                    <field name="date_order" readonly="1"/>
                                    <field name="expected_arrival" readonly="1"/>
                                    <field name="vendor_id" readonly="1"/>
                                    <field name="product_display" string="สินค้า" readonly="1"/>
                                    <field name="qty" readonly="1" widget="float" options="{'dp': 2}"/>
                                    <field name="qty_received" readonly="1" widget="float" options="{'dp': 2}"/>
                                    <field name="qty_pending_invoice" readonly="1" widget="float" options="{'dp': 2}"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="unit_price" readonly="1" widget="float" options="{'dp': 2}"/>
                                    <field name="subtotal" readonly="1" widget="float" options="{'dp': 2}"/>
                                    
                                    <field name="state" readonly="1" widget="badge" 
                                           decoration-info="state in ('draft', 'sent')"
                                           decoration-success="state == 'purchase'"
                                           decoration-warning="state == 'to approve'"/>

                                    <field name="billing_note_status" readonly="1" widget="badge"
                                            decoration-muted="billing_note_status == 'no'"
                                            decoration-info="billing_note_status == 'draft'"
                                            decoration-warning="billing_note_status == 'partial'"
                                            decoration-success="billing_note_status == 'fully'"/>
                                           
                                    <field name="invoice_status" readonly="1" widget="badge"
                                           decoration-muted="invoice_status == 'no'"
                                           decoration-info="invoice_status == 'to invoice'"
                                           decoration-success="invoice_status == 'invoiced'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_status_report_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Order Status Report</field>
        <field name="res_model">purchase.order.status.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_order_status_report_wizard"/>
        <field name="target">current</field>
    </record>
</odoo>