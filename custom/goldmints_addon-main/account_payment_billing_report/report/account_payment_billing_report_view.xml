<odoo>
    <record id="view_account_payment_billing_report_form" model="ir.ui.view">
        <field name="name">account.payment.billing.report.form</field>
        <field name="model">account.payment.billing.report</field>
        <field name="arch" type="xml">
            <form string="Payment Billing Report">
                <header>
                    <button name="action_preview" string="Preview" type="object" class="btn-info"/>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_print_excel" string="Export Excel" type="object" class="btn-secondary"/>
                </header>

                <sheet>
                    <group name="Payment billing report">
                        <field name="name" invisible="1"/>
                        <group name="details_filters">
                            <separator string="รายละเอียดตัวกรอง"/>
                            <field name="route_id" force_save="1" readonly="team_id or customer_ids" placeholder="เลือกสาย" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="subregion_ids" force_save="1" widget="many2many_tags" readonly="not route_id" required="route_id" placeholder="เลือกเขต" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="team_id" force_save="1" readonly="route_id or customer_ids" placeholder="เลือกทีมขาย" options="{'no_create': True, 'no_open': True}"/>
                            <field name="salesperson_ids" force_save="1" widget="many2many_tags" readonly="not team_id" placeholder="เลือกพนักงานขาย" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="customer_ids" force_save="1" widget="many2many_tags" readonly="route_id or team_id" placeholder="เลือกลูกค้า" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                        </group>

                        <group name="Date range and report settings">
                            <separator string="ช่วงวันที่และรายงาน"/>
                            <!-- <label for="select_month" string="เลือกช่วงเวลา (เดือน/ปี)"/>
                            <div class="o_row">
                                <field name="select_month" force_save="1" nolabel="1" placeholder="เลือกเดือน"/>
                                <field name="select_year" force_save="1" nolabel="1" placeholder="เลือกปี"/>
                            </div> -->
                            <field name="date_from" force_save="1" readonly="promised_payment_date" required="not promised_payment_date"/>
                            <field name="date_to" force_save="1" readonly="promised_payment_date" required="not promised_payment_date"/>
                            <field name="promised_payment_date" force_save="1" readonly="date_from or date_to" required="not date_from or not date_to"/>
                            <field name="report_id" force_save="1" required="1" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="ตัวอย่างผลลัพธ์">
                            <field name="result_line_ids">
                                <list string="Report Lines" create="0" delete="1" editable="bottom" default_order="partner_code, subregion_name, invoice_name">
                                    <field name="route_name" optional="show" readonly="1" width="100px"/>
                                    <field name="subregion_name" optional="show" readonly="1" width="120px"/>
                                    <field name="partner_code" optional="show" readonly="1" width="80px"/>
                                    <field name="partner_name" optional="show" readonly="1"/>
                                    <field name="sale_name" optional="show" readonly="1" width="150px"/>
                                    <field name="invoice_name" optional="show" readonly="1" width="150px"/>
                                    <field name="invoice_date" optional="show" readonly="1" width="100px"/>
                                    <field name="due_date" optional="show" readonly="1" width="100px"/>
                                    <field name="currency_id" column_invisible="1" readonly="1"/>
                                    <field name="amount_total" sum="Total" optional="show" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" width="250px"/>
                                    <field name="invoice_summary" optional="show" readonly="1"/>
                                    <field name="account_note" optional="show" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>