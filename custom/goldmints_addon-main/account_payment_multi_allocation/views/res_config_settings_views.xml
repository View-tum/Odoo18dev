<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.multi.allocation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="inside">
                <setting string="Multi-Invoice Allocation" help="Enable interactive table for selecting amounts per invoice in Payment Register.">
                    <field name="enable_multi_invoice_allocation"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
