<odoo>
    <record id="view_picking_type_form_inherit_description" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.description</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="require_description" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
