<odoo>
    <record id="view_pr_status_report_wizard_inherit_billing_note" model="ir.ui.view">
        <field name="name">purchase.request.status.report.wizard.inherit.billing.note</field>
        <field name="model">purchase.request.status.report.wizard</field>
        <field name="inherit_id" ref="purchase_request_status_report.view_purchase_request_status_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='button_export_xlsx']" position="after">
                <button name="action_create_billing_note"
                        string="Create Vendor Billing Note"
                        type="object"
                        class="btn-primary"
                        invisible="not vendor_id"/>
            </xpath>
        </field>
    </record>
</odoo>
