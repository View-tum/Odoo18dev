<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_billing_note" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.billing.note</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header/button[@name='action_create_invoice' and contains(@class, 'oe_highlight')]" position="attributes">
                <attribute name="invisible">not is_ready_to_create_bill or invoice_status != 'to invoice'</attribute>
            </xpath>
            
            <xpath expr="//header/button[@name='action_create_invoice' and not(contains(@class, 'oe_highlight'))]" position="attributes">
                <attribute name="invisible">not is_ready_to_create_bill or invoice_status not in ('no', 'invoiced') or state != 'purchase'</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_create_invoice'][1]" position="before">
                <button name="action_create_billing_note" 
                        string="Create Billing Note" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="not is_billing_note_ready" />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_billing_notes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        invisible="billing_note_count == 0">
                    <field name="billing_note_count" widget="statinfo" string="Billing Notes"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='state']" position="after">
                <field name="is_billing_note_ready" invisible="1"/>
                <field name="is_ready_to_create_bill" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_inherit_bn" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.bn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_invoice']" position="before">
                <button name="action_create_consolidated_billing_note" 
                        type="object" 
                        string="Create Billing Note"
                        class="oe_highlight"/> 
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_bn" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.bn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_create_consolidated_billing_note" 
                            type="object" 
                            string="Create Billing Note"
                            class="oe_highlight"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>