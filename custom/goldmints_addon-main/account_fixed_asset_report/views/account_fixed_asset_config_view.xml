<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_fixed_asset_config_tree" model="ir.ui.view">
        <field name="name">account.fixed.asset.config.tree</field>
        <field name="model">account.fixed.asset.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="excel_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                <field name="report_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <record id="view_account_fixed_asset_config_form" model="ir.ui.view">
        <field name="name">account.fixed.asset.config.form</field>
        <field name="model">account.fixed.asset.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="excel_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="report_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>