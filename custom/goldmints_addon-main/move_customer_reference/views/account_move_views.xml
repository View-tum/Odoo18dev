<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ref_move" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ref.move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="before">
                <field name="ref" string="Customer Reference"/>
            </xpath>

            <xpath expr="//page[@name='other_info']//label[@for='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='other_info']//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
