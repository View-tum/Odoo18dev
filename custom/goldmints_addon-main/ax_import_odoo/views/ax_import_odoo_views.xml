<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ax_import_odoo_wizard_form" model="ir.ui.view">
        <field name="name">ax.import.odoo.wizard.form</field>
        <field name="model">ax.import.odoo.wizard</field>
        <field name="arch" type="xml">
            <form string="AX Import Odoo">
                <sheet>
                    <group string="File">
                        <field name="company_id" invisible="1"/>
                        <field name="voucher_file" filename="voucher_filename"/>
                        <field name="voucher_filename" invisible="1"/>
                        <field name="default_journal_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Import Options">
                        <field name="post_entries"/>
                        <field name="skip_existing_moves"/>
                        <field name="account_code_mode"/>
                        <field name="create_missing_accounts"/>
                        <field name="create_missing_partners"/>
                        <field name="strict_partner_matching"/>
                        <field name="partner_policy"/>
                    </group>
                    <group string="Result">
                        <field name="created_move_count" readonly="1"/>
                        <field name="skipped_move_count" readonly="1"/>
                        <field name="failed_move_count" readonly="1"/>
                        <field name="created_move_ids" readonly="1" widget="many2many_tags" invisible="created_move_count == 0"/>
                    </group>
                    <group string="Notes">
                        <div class="o_form_label">Each sheet is imported as one journal entry. The importer reads the AX voucher metadata and the Account No. / Debit / Credit journal line table.</div>
                        <div class="o_form_label">Default account matching uses the main account before the AX dash suffix, for example 700018-7 is matched as 700018.</div>
                        <div class="o_form_label">AX voucher numbers are stored on the journal entry and used to skip duplicate imports.</div>
                    </group>
                    <group string="Log">
                        <field name="log" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Import" type="object" name="action_import_ax_import_odoo" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ax_import_odoo_wizard" model="ir.actions.act_window">
        <field name="name">AX Import Odoo</field>
        <field name="res_model">ax.import.odoo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ax_import_odoo_wizard"
              name="AX Import Odoo"
              parent="account.menu_finance_entries"
              action="action_ax_import_odoo_wizard"
              sequence="95"
              groups="account.group_account_manager"/>
</odoo>
