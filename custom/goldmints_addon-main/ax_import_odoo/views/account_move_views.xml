<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ax_import_odoo" model="ir.ui.view">
        <field name="name">account.move.form.ax.import.odoo</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="ax_voucher_number" readonly="1"/>
                <field name="ax_document_number" readonly="1"/>
                <field name="ax_journal_number" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
