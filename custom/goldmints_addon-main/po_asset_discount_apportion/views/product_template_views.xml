<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_apportion_discount" model="ir.ui.view">
        <field name="name">product.template.form.apportion.discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Discount Apportionment">
                    <field name="is_apportion_discount"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
