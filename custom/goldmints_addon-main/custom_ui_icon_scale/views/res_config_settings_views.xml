<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ui.icon.scale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="UI Customization" string="UI Customization" name="ui_customization">
                    <block title="Icon Scaling" name="icon_scaling_setting_container">
                        <setting id="ui_icon_scale_setting" title="Icon Scaling" help="Scale factor for Save and Cancel icons. 1.0 is default, 1.2 is 20% larger.">
                            <field name="ui_icon_scale"/>
                            <div class="mt-2 text-muted">Scale factor (e.g., 1.5)</div>
                        </setting>
                        <setting id="ui_icon_spacing_setting" title="Icon Spacing" help="Horizontal spacing between icons in pixels.">
                            <field name="ui_icon_spacing"/>
                            <div class="mt-2 text-muted">Spacing in pixels (e.g., 10)</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
