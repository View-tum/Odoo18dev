<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_thb_difference" model="ir.ui.view">
        <field name="name">account.payment.register.form.thb.difference</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//div[@name='amount_div']/field[@name='currency_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or not can_edit_wizard</attribute>
                <attribute name="required">require_partner_bank_account and can_edit_wizard</attribute>
            </xpath>
            <xpath expr="//field[@name='communication']" position="attributes">
                <attribute name="invisible">not can_edit_wizard</attribute>
            </xpath>
            <xpath expr="//field[@name='manual_currency_rate_active']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='manual_currency_rate']" position="attributes">
                <attribute name="invisible">not manual_currency_rate_active</attribute>
                <attribute name="required">manual_currency_rate_active</attribute>
            </xpath>
        </field>
    </record>
</odoo>
