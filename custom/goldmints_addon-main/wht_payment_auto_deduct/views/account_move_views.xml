<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_wht_multi_select" model="ir.ui.view">
        <field name="name">account.move.form.wht.multi.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_th_account_tax.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page/field[@name='invoice_line_ids']/list/field[@name='wht_tax_id']"
                position="replace"
            >
                <field
                    name="wht_tax_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    optional="show"
                />
                <field name="wht_tax_id" column_invisible="1" invisible="1" />
            </xpath>
            <xpath
                expr="//page/field[@name='invoice_line_ids']/form//field[@name='wht_tax_id']"
                position="replace"
            >
                <field
                    name="wht_tax_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    optional="show"
                />
                <field name="wht_tax_id" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
