<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_consolidated_reversal_form" model="ir.ui.view">
        <field name="name">account.move.consolidated.reversal.form</field>
        <field name="model">account.move.consolidated.reversal</field>
        <field name="arch" type="xml">
            <form string="Consolidate Bills and Returns">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="move_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="filter_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="search_ref" placeholder="e.g. INV-D/26... or Product Name"/>
                    </group>
                </group>
                <notebook>
                    <page string="Items to Consolidate">
                        <field name="line_ids">
                            <list editable="bottom" create="false" delete="false">
                                <field name="is_selected"/>
                                <field name="source_type"/>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="price_unit"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm" string="Add to Credit Note" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
