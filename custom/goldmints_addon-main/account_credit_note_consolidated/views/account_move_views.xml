<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_consolidation" model="ir.ui.view">
        <field name="name">account.move.form.inherit.consolidation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_consolidation_wizard" 
                        string="Consolidate Items" 
                        type="object" 
                        class="oe_highlight"
                        invisible="move_type not in ('in_refund', 'out_refund') or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
