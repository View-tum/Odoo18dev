<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_vendor_credit_note_status" model="ir.ui.view">
        <field name="name">stock.picking.form.vendor.credit.note.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_credit_notes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="vendor_credit_note_count == 0">
                    <field name="vendor_credit_note_count" string="Credit Notes" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="vendor_credit_note_state"
                       widget="badge"
                       readonly="1"
                       invisible="vendor_credit_note_state == 'not_required'"
                       decoration-muted="vendor_credit_note_state == 'to_credit'"
                       decoration-info="vendor_credit_note_state == 'draft'"
                       decoration-success="vendor_credit_note_state == 'posted'"
                       decoration-danger="vendor_credit_note_state == 'cancelled'"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_vendor_credit_note_status" model="ir.ui.view">
        <field name="name">stock.picking.list.vendor.credit.note.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="vendor_credit_note_state"
                       string="Vendor CN"
                       optional="hide"
                       widget="badge"
                       decoration-muted="vendor_credit_note_state == 'to_credit'"
                       decoration-info="vendor_credit_note_state == 'draft'"
                       decoration-success="vendor_credit_note_state == 'posted'"
                       decoration-danger="vendor_credit_note_state == 'cancelled'"/>
            </xpath>
        </field>
    </record>
</odoo>
