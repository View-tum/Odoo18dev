<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qa_account_test_run_tree" model="ir.ui.view">
        <field name="name">qa.account.test.run.tree</field>
        <field name="model">qa.account.test.run</field>
        <field name="arch" type="xml">
            <list string="Account Test Runs" create="1" edit="1" delete="1">
                <field name="name"/>
                <field name="state"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="total_count"/>
                <field name="pass_count"/>
                <field name="fail_count"/>
                <field name="skip_count"/>
                <field name="user_id"/>
                <field name="db_name"/>
            </list>
        </field>
    </record>

    <record id="view_qa_account_test_run_form" model="ir.ui.view">
        <field name="name">qa.account.test.run.form</field>
        <field name="model">qa.account.test.run</field>
        <field name="arch" type="xml">
            <form string="Account Test Run">
                <header>
                    <button name="action_run_full_suite"
                            type="object"
                            string="Run Full Suite"
                            class="btn-primary"
                            invisible="state == 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="db_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="total_count" readonly="1"/>
                            <field name="pass_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="fail_count" readonly="1"/>
                            <field name="skip_count" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Results">
                            <field name="line_ids" readonly="1">
                                <list string="Case Results" create="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="case_code"/>
                                    <field name="case_name"/>
                                    <field name="status"/>
                                    <field name="duration_ms"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qa_account_test_run_search" model="ir.ui.view">
        <field name="name">qa.account.test.run.search</field>
        <field name="model">qa.account.test.run</field>
        <field name="arch" type="xml">
            <search string="Account Test Runs">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <filter name="filter_failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="filter_done" string="Done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qa_account_test_run" model="ir.actions.act_window">
        <field name="name">Account Test Runs</field>
        <field name="res_model">qa.account.test.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qa_account_test_run_search"/>
    </record>

    <menuitem id="menu_qa_account_test_root"
              name="Account Test Runs"
              parent="account.menu_finance_configuration"
              action="action_qa_account_test_run"
              sequence="350"
              groups="account.group_account_manager"/>
</odoo>
