<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_job_request" model="ir.ui.view">
        <field name="name">stock.picking.form.job.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_job_request" icon="fa-clipboard"
                    invisible="not job_request_count">
                    <field name="job_request_count" widget="statinfo" string="Job Request" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
