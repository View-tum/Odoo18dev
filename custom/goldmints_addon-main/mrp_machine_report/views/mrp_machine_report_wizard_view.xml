<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_machine_report_wizard_form" model="ir.ui.view">
        <field name="name">mrp.machine.report.wizard.form</field>
        <field name="model">mrp.machine.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Machine Report">

                <field name="report_id" invisible="1"/>
                
                <!-- =====================
                     Date Range
                     ===================== -->
                <group string="Date Range">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <!-- =====================
                     Filters
                     ===================== -->
                <group string="Filters">
                    <field name="factory_tag_ids"
                           widget="many2many_tags"
                           placeholder="Select factory type (Drug / Plastic)"/>
                    <field name="machine_ids"
                           widget="many2many_tags"
                           placeholder="Select machine(s)"/>
                    <field name="scrap_filter"/>
                    <field name="include_not_done"/>
                </group>

                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print Report"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>
