<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_account_note" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.account.note</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Receivable Notes" name="ar_notes">
                    <field name="account_note" placeholder="ใส่หมายเหตุสำหรับภายในบัญชีที่นี่..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>