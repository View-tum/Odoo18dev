<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_late_backorder_recovery" model="ir.ui.view">
        <field name="name">stock.picking.form.late.backorder.recovery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_create_late_backorder" invisible="1"/>
                <field name="late_backorder_move_count" invisible="1"/>
                <button name="action_create_late_backorder"
                        type="object"
                        string="Create Backorder"
                        class="btn-primary"
                        invisible="not can_create_late_backorder"/>
            </xpath>
        </field>
    </record>
</odoo>
