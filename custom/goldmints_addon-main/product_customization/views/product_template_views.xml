<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_custom" model="ir.ui.view">
        <field name="name">product.template.product.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
        	 <xpath expr="//div[field[@name='sale_delay']]" position="after">
                    <label for="gross_weight"/>
	                <div>
	                    <field name="gross_weight" class="oe_inline" style="vertical-align:baseline"/>
Kgs
	                </div>
	                 <label for="net_weight"/>
	                <div>
	                    <field name="net_weight" class="oe_inline" style="vertical-align:baseline"/>
Kgs
	                </div>
	                 <label for="dimension"/>
	                <div>
	                    <field name="dimension" class="oe_inline" style="vertical-align:baseline"/>
cm
	                </div>
	                <field name="number_of_cartons"/>
                </xpath>
        </field>
	</record>
</odoo>