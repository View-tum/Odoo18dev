<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_export_payment" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.export.payment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field name="export_payment_term365" options="{'no_create': True, 'no_edit': True}" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_order_365_form_view1">
        <field name="name">sale.order.365.shipping.policy.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_policy']" position="after">
                <field name="shipping_policy365" options="{'no_create': True, 'no_edit': True}" />
                 <field name="export_payment_term365" options="{'no_create': True, 'no_edit': True}" />
                <field name="shipping_method" widget="radio"/>
                <field name="shipping_address" invisible="shipping_method != 'shipto-address'"/>
            </xpath>
            <xpath expr="//field[@name='expected_date']" position="before">

            </xpath>

        </field>
    </record>

    <!-- Operation Type Extension -->
    <record id="view_picking_type_form_inherit_shipping_method" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.shipping.method</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_delivery_address']" position="after">
                <field name="is_show_shipping_method"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Picking (Delivery Order) Extension -->
    <record id="view_picking_form_inherit_shipping_method" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.shipping.method</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_show_shipping_method" invisible="1"/>
                <field name="shipping_method" invisible="is_show_shipping_method == False"/>
                <field name="shipping_address" invisible="is_show_shipping_method == False or shipping_method != 'shipto-address'"/>
            </xpath>
        </field>
    </record>

    <!-- menu -->
    <record id="sale_shipping_policy365_tree" model="ir.ui.view">
        <field name="name">Export Shipping Policy</field>
        <field name="model">sale.order.shipping.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="sale_export_payment_term365_tree" model="ir.ui.view">
        <field name="name">Export Payment Term</field>
        <field name="model">sale.order.export.payment.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_export_shipping_policy365" model="ir.actions.act_window">
        <field name="name">Export Shipping Policy</field>
        <field name="res_model">sale.order.shipping.policy</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_export_payment_term365" model="ir.actions.act_window">
        <field name="name">Export Payment Term</field>
        <field name="res_model">sale.order.export.payment.term</field>
        <field name="view_mode">list</field>
    </record>


     <menuitem id="shipping_policy_menu" action="action_export_shipping_policy365" name="Export Shipping Policy" parent="sale.menu_sales_config"/>
     <menuitem id="export_payment_term_menu" action="action_export_payment_term365" name="Export Payment Term" parent="sale.menu_sales_config"/>
    <!-- end menu -->

</odoo>
