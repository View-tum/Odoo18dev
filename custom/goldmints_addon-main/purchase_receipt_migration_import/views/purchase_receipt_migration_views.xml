<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_receipt_migration_batch_tree" model="ir.ui.view">
        <field name="name">purchase.receipt.migration.batch.tree</field>
        <field name="model">purchase.receipt.migration.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="default_picking_type_id"/>
                <field name="state"/>
                <field name="po_line_count"/>
                <field name="po_error_count"/>
                <field name="receipt_line_count"/>
                <field name="receipt_error_count"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_receipt_migration_batch_form" model="ir.ui.view">
        <field name="name">purchase.receipt.migration.batch.form</field>
        <field name="model">purchase.receipt.migration.batch</field>
        <field name="arch" type="xml">
            <form string="PO + Receipt Migration Batch">
                <header>
                    <button name="action_parse_file" type="object" string="Parse File" class="btn-primary" invisible="state not in ('draft',)"/>
                    <button name="action_recompute_mapping" type="object" string="Recompute Mapping" invisible="state not in ('parsed','po_created')"/>
                    <button name="action_create_purchase_orders" type="object" string="Create Purchase Orders" class="btn-primary" invisible="state not in ('parsed',)"/>
                    <button name="action_create_receipts" type="object" string="Create Receipts" class="btn-primary" invisible="state not in ('po_created',)"/>
                    <button name="action_reset_lines" type="object" string="Reset" invisible="state not in ('parsed','po_created','done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,parsed,po_created,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="default_picking_type_id"/>
                        </group>
                        <group>
                            <field name="filename"/>
                            <field name="data_file" filename="filename"/>
                        </group>
                    </group>
                    <group>
                        <group string="PO Summary">
                            <field name="po_line_count" readonly="1"/>
                            <field name="po_mapped_count" readonly="1"/>
                            <field name="po_error_count" readonly="1"/>
                        </group>
                        <group string="Receipt Summary">
                            <field name="receipt_line_count" readonly="1"/>
                            <field name="receipt_mapped_count" readonly="1"/>
                            <field name="receipt_error_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="PO Lines">
                            <field name="po_line_ids" readonly="1">
                                <list>
                                    <field name="source_row_no"/>
                                    <field name="state"/>
                                    <field name="po_number"/>
                                    <field name="po_line_ref"/>
                                    <field name="vendor_code"/>
                                    <field name="product_code"/>
                                    <field name="order_qty"/>
                                    <field name="unit_price"/>
                                    <field name="partner_id"/>
                                    <field name="product_id"/>
                                    <field name="currency_id"/>
                                    <field name="uom_id"/>
                                    <field name="picking_type_id"/>
                                    <field name="purchase_order_id"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Receipt Lines">
                            <field name="receipt_line_ids" readonly="1">
                                <list>
                                    <field name="source_row_no"/>
                                    <field name="state"/>
                                    <field name="po_number"/>
                                    <field name="po_line_ref"/>
                                    <field name="po_source_row_no"/>
                                    <field name="product_code"/>
                                    <field name="qty_done"/>
                                    <field name="receipt_date"/>
                                    <field name="lot_name"/>
                                    <field name="dest_location_complete_name"/>
                                    <field name="tracking"/>
                                    <field name="product_id"/>
                                    <field name="dest_location_id"/>
                                    <field name="picking_id"/>
                                    <field name="move_line_id"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_receipt_migration_batch" model="ir.actions.act_window">
        <field name="name">PO + Receipt Migration</field>
        <field name="res_model">purchase.receipt.migration.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_receipt_migration_root"
              name="PO + Receipt Migration"
              parent="purchase.menu_purchase_root"
              action="action_purchase_receipt_migration_batch"
              sequence="95"
              groups="purchase.group_purchase_manager"/>
</odoo>
