<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_import_wizard" model="ir.ui.view">
        <field name="name">sale.order.import.wizard.form</field>
        <field name="model">sale.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sale Orders">
                <group>
                    <field name="data_file" filename="filename" required="1"/>
                    <field name="filename" readonly="1"/>
                    <field name="update_existing"/>
                    <field name="apply_discount_to_price"/>
                </group>
                <group>
                    <field name="success_count"/>
                    <field name="fail_count"/>
                </group>
                <group>
                    <field name="failure_file" filename="failure_filename" readonly="1"/>
                </group>
                <field name="log_message" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Sale Orders</field>
        <field name="res_model">sale.order.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_order_import_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sale_order_import_wizard"
              name="Import Sale Orders"
              parent="sale.menu_sale_order"
              action="action_sale_order_import_wizard"
              sequence="90"/>
</odoo>
