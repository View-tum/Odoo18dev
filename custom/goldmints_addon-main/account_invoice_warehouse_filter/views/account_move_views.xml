<odoo>
    <record id="view_move_form_inherit_warehouse" model="ir.ui.view">
        <field name="name">account.move.form.inherit.warehouse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="warehouse_id" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_warehouse" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit.warehouse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="warehouse_id" optional="show" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_warehouse" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit.warehouse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="warehouse_id"/>
            </field>
            <xpath expr="//search/group/filter[@name='invoicedate']" position="after">
                <filter string="Warehouse" name="grp_warehouse_id" domain="[]" context="{'group_by': 'warehouse_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_warehouse" model="ir.ui.view">
        <field name="name">account.move.select.inherit.warehouse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="warehouse_id"/>
            </field>
            <xpath expr="//search/group/filter[@name='by_date']" position="after">
                <filter string="Warehouse" name="grp_warehouse_id" domain="[]" context="{'group_by': 'warehouse_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
