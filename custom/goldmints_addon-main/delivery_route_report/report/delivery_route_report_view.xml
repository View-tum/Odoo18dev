<odoo>
  <record id="view_delivery_route_report_form" model="ir.ui.view">
    <field name="name">delivery.route.report.form</field>
    <field name="model">delivery.route.report</field>
    <field name="arch" type="xml">

      <form string="Route reports">
        <sheet>

          <group name="details_filters">
            <separator string="รายละเอียดตัวกรอง"/>
            <field name="route_id" required="True" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
            <field name="subregion_ids" widget="many2many_tags" required="route_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
          </group>

          <group name="Date range and report settings">
            <separator string="ช่วงวันที่และการตั้งค่ารายงาน"/>
            <field name="date_from" required="route_id"/>
            <field name="date_to" required="route_id"/>
            <field name="report_id" required="route_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
          </group>

        </sheet>

        <footer>
          <button string="Confirm" name="action_generate_lines" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>

      </form>
    </field>
  </record>

  <record id="view_delivery_route_report_line_list" model="ir.ui.view">
    <field name="name">delivery.route.report.line.list</field>
    <field name="model">delivery.route.report.line</field>
    <field name="arch" type="xml">
      <list string="Delivery Lines" create="0" delete="0">
        <field name="subregion_id" readonly="1" optional="show" options="{'no_open': True}"/>
        <field name="sale_id" readonly="1" optional="show" options="{'no_open': True}"/>
        <field name="picking_id" readonly="1" optional="hide" options="{'no_open': True}"/>
        <field name="ref" readonly="1" optional="show"/>
        <field name="partner_id" readonly="1" optional="show" options="{'no_open': True}"/>
        <field name="amount_total" sum="Total" readonly="1" optional="show"/>
        <field name="currency_id" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="action_print_selected_delivery_lines" model="ir.actions.server">
    <field name="name">พิมพ์ใบจัดสาย</field>
    <field name="model_id" ref="model_delivery_route_report_line"/>
    <field name="binding_model_id" ref="model_delivery_route_report_line"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
    if records:
        report_wizard = records[0].report_id
        action = report_wizard.print_selected_lines(records.ids)
    </field>
  </record>

</odoo>
