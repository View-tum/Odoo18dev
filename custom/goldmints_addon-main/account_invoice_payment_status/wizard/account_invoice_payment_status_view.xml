<odoo>
    <record id="view_account_invoice_payment_status_form" model="ir.ui.view">
        <field name="name">account.invoice.payment.status.form</field>
        <field name="model">account.invoice.payment.status</field>
        <field name="arch" type="xml">
            <form string="Account Invoice Payment Status">
                <header>
                    <button string="Preview" name="action_preview" type="object" class="btn-info"/>
                    <button string="Print PDF" name="action_print_pdf" type="object" class="btn-primary"/>
                    <button string="Export Excel" name="action_export_excel" type="object" class="btn-secondary"/>
                </header>

                <sheet>
                    <group>
                        <group name="details_filters">
                            <separator string="รายละเอียดตัวกรอง"/>
                            <field name="route_id" force_save="1" readonly="team_id or customer_ids" placeholder="เลือกสายรถ" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="subregion_ids" force_save="1" widget="many2many_tags" readonly="not route_id" placeholder="เลือกเขตย่อย" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="customer_ids" force_save="1" widget="many2many_tags" readonly="team_id or route_id" placeholder="เลือกลูกค้า" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="team_id" force_save="1" readonly="customer_ids or route_id" placeholder="เลือกทีมขาย" options="{'no_create': True, 'no_open': True}"/>
                            <field name="salesperson_ids" force_save="1" widget="many2many_tags" readonly="not team_id" placeholder="เลือกพนักงานขาย" options="{'no_create': True, 'no_open': True}"/>
                        </group>

                        <group name="Date range and report settings">
                            <separator string="ช่วงวันที่และรายงาน"/>
                            <!-- <label for="select_month" string="เลือกช่วงเวลา (เดือน/ปี)"/>
                            <div class="o_row">
                                <field name="select_month" force_save="1" nolabel="1" placeholder="เลือกเดือน"/>
                                <field name="select_year" force_save="1" nolabel="1" placeholder="เลือกปี"/>
                            </div> -->
                            <field name="payment_state" placeholder="สถานะทั้งหมด"/>
                            <field name="date_from" force_save="1" required="1"/>
                            <field name="date_to" force_save="1" required="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices" name="invoice_tab">
                            <field name="invoice_line_ids" readonly="0">
                                <list decoration-muted="payment_state == 'reversed'" default_order="partner_id, invoice_date desc" delete="true" editable="bottom" create="0">
                                    <field name="invoice_name" width="120px"/>
                                    <field name="ref" width="50px"/>
                                    <field name="partner_id" width="340px"/>
                                    <field name="user_id" width="180px" optional="show"/>
                                    <field name="invoice_date" optional="show" width="100px" class="text-nowrap"/>
                                    <field name="invoice_date_due" optional="hide" width="100px" class="text-nowrap"/>
                                    <field name="payment_date" optional="hide" width="100px" class="text-nowrap"/>
                                    <field name="amount_total" sum="Total" width="100px"/>
                                    <field name="amount_residual" sum="Due" width="100px"/>
                                    <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-info="payment_state == 'partial'" decoration-warning="payment_state == 'in_payment'" decoration-success="payment_state == 'paid'" width="100px"/>
                                    <!-- <field name="statement_date" optional="show" width="100px"/> -->
                                    <field name="invoice_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>