<odoo>
    <record id="crm_claims_ept_form_view_transform_inherit" model="ir.ui.view">
        <field name="name">crm.claim.ept.form.transform.inherit</field>
        <field name="model">crm.claim.ept</field>
        <field name="inherit_id" ref="rma_ept.crm_claims_ept_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='invisible_fields']" position="inside">
                <field name="transform_id"/>
            </xpath>
            <xpath expr="//field[@name='sale_id']" position="after">
                <field name="invoice_id" readonly="1"/>
                <field name="transform_id" readonly="1" invisible="not transform_id"/>
            </xpath>
            <xpath expr="//field[@name='claim_line_ids']/list/field[@name='move_id']" position="before">
                <field name="transform_id" readonly="1" optional="show"/>
                <field name="transform_original_product_id" readonly="1" optional="hide"/>
                <field name="transform_invoice_id" readonly="1" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='claim_line_ids']/form//field[@name='product_id']" position="after">
                <field name="transform_id" readonly="1"/>
                <field name="transform_original_product_id" readonly="1"/>
                <field name="transform_invoice_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
