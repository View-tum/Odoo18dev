<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_transform" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.transform</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_product_transform" 
                        string="Create Transform" 
                        type="object" 
                        class="btn-secondary"
                        invisible="state != 'done' or picking_type_code == 'outgoing'"/>
                <button name="action_create_rma_transform_return"
                        string="RMA Transform Return"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done' or picking_type_code != 'outgoing'"/>
            </xpath>
        </field>
    </record>
</odoo>
