<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_bold_note" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.bold.note</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notes']" position="attributes">
                <attribute name="class" add="my_bold_note" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>