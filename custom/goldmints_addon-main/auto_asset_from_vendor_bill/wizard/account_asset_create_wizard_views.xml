<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_create_wizard_form" model="ir.ui.view">
        <field name="name">account.asset.create.wizard.form</field>
        <field name="model">account.asset.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Assets from Bill">
                <sheet>
                    <group>
                        <field name="move_id"/>
                    </group>
                    <notebook>
                        <page string="Bill Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="asset_model_id" required="1"/>
                                    <field name="split_individual"/>
                                    <field name="target_asset_id" placeholder="Add to existing..."/>
                                    <field name="parent_asset_id" placeholder="Attach to machine..."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_assets" string="Create Assets" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
