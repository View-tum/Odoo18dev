<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template form: add Asset Model group in Accounting tab -->
    <record id="view_product_template_form_inherit_asset" model="ir.ui.view">
        <field name="name">product.template.form.asset.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="after">
                <group string="Asset Model" groups="account.group_account_user">
                    <field name="asset_model_id"/>
                    <field name="split_assets" invisible="not asset_model_id" required="asset_model_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Variant form: add Asset Model group in Accounting tab -->
    <record id="view_product_variant_form_inherit_asset" model="ir.ui.view">
        <field name="name">product.product.form.asset.model</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="after">
                <group string="Asset Model" groups="account.group_account_user">
                    <field name="asset_model_id"/>
                    <field name="split_assets" invisible="not asset_model_id" required="asset_model_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
