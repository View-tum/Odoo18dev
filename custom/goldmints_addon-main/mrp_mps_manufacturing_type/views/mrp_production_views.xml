<odoo>
    <!-- Plastic MO Action -->
    <record id="action_mrp_production_plastic" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders (Plastic)</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="domain">[('manufacturing_type', '=', 'plastic')]</field>
        <field name="context">{'default_manufacturing_type': 'plastic'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manufacturing orders for Plastic factory.
            </p>
        </field>
    </record>

    <!-- Pharma MO Action -->
    <record id="action_mrp_production_pharma" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders (Pharma)</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="domain">[('manufacturing_type', '=', 'pharma')]</field>
        <field name="context">{'default_manufacturing_type': 'pharma'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manufacturing orders for Pharma factory.
            </p>
        </field>
    </record>

    <!-- Menu Items under Operations -->
    <menuitem id="menu_mrp_production_plastic"
              name="Manufacturing Orders (Plastic)"
              parent="mrp.menu_mrp_manufacturing"
              action="action_mrp_production_plastic"
              sequence="2"
    />

    <menuitem id="menu_mrp_production_pharma"
              name="Manufacturing Orders (Pharma)"
              parent="mrp.menu_mrp_manufacturing"
              action="action_mrp_production_pharma"
              sequence="3"
    />

    <!-- Inherit MO Tree view to show Manufacturing Type -->
    <record id="mrp_production_tree_view_inherit_manufacturing_type" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.manufacturing.type</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="manufacturing_type" optional="show" widget="badge" decoration-info="manufacturing_type == 'plastic'" decoration-warning="manufacturing_type == 'pharma'"/>
            </xpath>
        </field>
    </record>
</odoo>
