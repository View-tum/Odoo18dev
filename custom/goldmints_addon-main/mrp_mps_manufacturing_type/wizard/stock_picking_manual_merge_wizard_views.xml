<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_manual_merge_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.manual.merge.wizard.form</field>
        <field name="model">stock.picking.manual.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Internal Transfers">
                <sheet>
                    <group>
                        <field name="target_picking_id" readonly="1"/>
                        <field name="manufacturing_type" readonly="1" widget="badge"/>
                    </group>
                    <field name="picking_ids" widget="many2many" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="scheduled_date"/>
                            <field name="picking_type_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="manufacturing_type" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_merge" type="object" string="Merge Transfers" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_manual_merge_from_operations" model="ir.actions.server">
        <field name="name">Merge Internal Transfers</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_manual_merge_internal_transfers()</field>
    </record>

    <record id="action_stock_picking_manual_merge_from_mo" model="ir.actions.server">
        <field name="name">Merge Internal Transfers</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_manual_merge_internal_transfers()</field>
    </record>
</odoo>
