<odoo>
    <record id="view_move_form_inherit_billing_schedule_date" model="ir.ui.view">
        <field name="name">account.move.form.inherit.billing_schedule_date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="billing_schedule_date"/>
            </xpath>
        </field>
    </record>
</odoo>
