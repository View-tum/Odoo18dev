<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Export Shipment -->
  <record id="view_export_shipment_tree" model="ir.ui.view">
    <field name="name">export.shipment.tree</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="order_id" options="{'no_create' : True, 'no_create_edit': True}"/>
        <field name="partner_id" options="{'no_create' : True, 'no_create_edit': True}"/>
        <field name="total_boxes" sum="Total Boxes"/>
      </list>
    </field>
  </record>

  <record id="view_export_shipment_form" model="ir.ui.view">
    <field name="name">export.shipment.form</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
              name="button_done"
              invisible="state in ('done')"
              string="Mark as Done"
              type="object"
              class="oe_highlight"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,done" statusbar_colors='{"done":"blue"}'/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="is_editable" invisible="1"/>
              <field name="name" readonly="1"/>
              <field name="date" readonly="is_editable == False"/>
              <field name="company_id" readonly="1"/>
              <field name="total_boxes" readonly="1"/>
            </group>
            <group>
              <field name="order_id" options="{'no_create' : True, 'no_create_edit': True}" readonly="is_editable == False"/>
              <field name="partner_id" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Order Lines">
              <field name="line_ids" readonly="is_editable == False">
                <list editable="bottom">
                  <field name="product_id" options="{'no_create' : True, 'no_create_edit': True}"/>
                  <field name="name"/>
                  <field name="product_qty"/>
                  <field name="uom_id" options="{'no_create' : True, 'no_create_edit': True}"/>
                  <field name="mfg"/>
                  <field name="exp"/>
                  <field name="lot"/>
                  <field name="image" widget="image" options="{'size': [0, 64]}"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_export_shipment" model="ir.actions.act_window">
    <field name="name">Export Shipment</field>
    <field name="res_model">export.shipment</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
