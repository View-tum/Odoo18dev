<odoo>
    <data noupdate="1">
        <record id="rule_advance_cash_log_user_own_records" model="ir.rule">
            <field name="name">Advance Cash Log: Own Records Only</field>
            <field name="model_id" ref="model_advance_cash_log" />
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <record id="rule_advance_cash_log_accountant_all" model="ir.rule">
            <field name="name">Advance Cash Log: Accountant All</field>
            <field name="model_id" ref="model_advance_cash_log" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                eval="[(4, ref('account.group_account_user')), (4, ref('account.group_account_manager'))]" />
        </record>

        <!-- Multi-Company Rules -->
        <record id="rule_advance_cash_log_multi_company" model="ir.rule">
            <field name="name">Advance Cash Log: Multi-Company</field>
            <field name="model_id" ref="model_advance_cash_log" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_advance_cash_log_line_multi_company" model="ir.rule">
            <field name="name">Advance Cash Log Line: Multi-Company</field>
            <field name="model_id" ref="model_advance_cash_log_line" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
