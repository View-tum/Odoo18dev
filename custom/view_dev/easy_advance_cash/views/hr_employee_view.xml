<odoo>
    <record id="view_employee_form_advance_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.advance.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_advance_logs" type="object" class="oe_stat_button"
                    icon="fa-money">
                    <div class="o_stat_info">
                        <field name="advance_balance" widget="monetary" />
                        <span class="o_stat_text">Advance Balance</span>
                    </div>
                </button>
                <button name="action_sync_balance" type="object" class="oe_stat_button"
                    icon="fa-refresh" string="Sync Balance" groups="account.group_account_user" />
            </xpath>
        </field>
    </record>
</odoo>
