<odoo>
    <record id="view_account_journal_form_advance_ext" model="ir.ui.view">
        <field name="name">account.journal.form.advance.ext</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_account_id']" position="after">
                <field name="advance_account_id" invisible="type not in ('cash', 'bank', 'general')" />
                <field name="advance_cash_limit" invisible="type not in ('cash', 'bank', 'general')" />
            </xpath>
        </field>
    </record>
</odoo>
