<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_form_inherit_register_number" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.register.number</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <h2>
                    <field name="asset_register_number" placeholder="เลขทะเบียนคุม FIX ASSET"/>
                </h2>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_search_inherit_register_number" model="ir.ui.view">
        <field name="name">account.asset.search.inherit.register.number</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="asset_register_number" string="เลขทะเบียนคุม FIX ASSET"/>
            </field>
        </field>
    </record>

    <record id="view_account_asset_purchase_tree_inherit_register_number" model="ir.ui.view">
        <field name="name">account.asset.purchase.tree.inherit.register.number</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="asset_register_number" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
