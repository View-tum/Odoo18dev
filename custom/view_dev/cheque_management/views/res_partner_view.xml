<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_payee_names" model="ir.ui.view">
        <field name="name">res.partner.form.payee.names</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="payee_names" string="Payee Names">
                    <field name="payee_name_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="is_default" readonly="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
