<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_petty_cash" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.petty.cash</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Easy Petty Cash" id="easy_petty_cash_setting_block">
                    <setting id="petty_cash_default"
                        title="Default Configuration for Petty Cash"
                        help="Configure defaults for Petty Cash logs.">
                        <group>
                            <field name="petty_cash_journal_id" options="{'no_create': True}" />
                            <field name="analytic_precision" invisible="1" />
                            <field name="petty_cash_analytic_distribution"
                                widget="analytic_distribution"
                                options="{'account_field': 'petty_cash_journal_id'}" />
                        </group>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
