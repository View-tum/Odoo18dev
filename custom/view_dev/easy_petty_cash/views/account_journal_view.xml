<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_petty_wht" model="ir.ui.view">
        <field name="name">account.journal.form.petty.wht</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_account_id']" position="after">
                <field name="petty_cash_wht_account_id" invisible="type != 'cash'" />
                <field name="petty_cash_limit" invisible="type != 'cash'" />
            </xpath>
        </field>
    </record>
</odoo>
