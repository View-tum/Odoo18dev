<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_partner_settlement" model="ir.ui.view">
        <field name="name">account.move.form.inherit.partner.settlement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_settlement_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="settlement_move_count == 0">
                    <field name="settlement_move_count" widget="statinfo" string="Settlements"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
