      "arch_excerpt": "<data><xpath expr=\"//field[@name='sale_id']\" position=\"after\">\n                <field name=\"rma_transform_return_id\" readonly=\"1\" invisible=\"not rma_transform_return_id\"/>\n            </xpath>\n            <xpath expr=\"//field[@name='claim_line_ids']/list/field[@name='move_id']\" position=\"before\">\n                <field name=\"rma_transform_return_id\" readonly=\"1\" optional=\"hide\"/>\n                <field name=\"rma_transform_return_line_id\" readonly=\"1\" optional=\"show\"/>\n                <field name=\"rma_transform_original_product_id\" readonly=\"1\" optional=\"hide\"/>\n                <field name=\"rma_transform_invoice_id\" readonly=\"1\" optional=\"hide\"/>\n            </xpath>\n            <xpath expr=\"//field[@name='claim_line_ids']/form//field[@name='product_id']\" position=\"after\">\n                <field name=\"rma_transform_return_id\" readonly=\"1\"/>\n                <field name=\"rma_transform_return_line_id\" readonly=\"1\"/>\n                <field name=\"rma_transform_original_product_id\" readonly=\"1\"/>\n                <field name=\"rma_transform_invoice_id\" readonly=\"1\"/>\n            </xpath>\n        </data>"
