      "arch_excerpt": "<data><xpath expr=\"//group[@name='invisible_fields']\" position=\"inside\">\n                <field name=\"transform_id\"/>\n            </xpath>\n            <xpath expr=\"//field[@name='sale_id']\" position=\"after\">\n                <field name=\"invoice_id\" readonly=\"1\"/>\n                <field name=\"transform_id\" readonly=\"1\" invisible=\"not transform_id\"/>\n            </xpath>\n            <xpath expr=\"//field[@name='claim_line_ids']/list/field[@name='move_id']\" position=\"before\">\n                <field name=\"transform_id\" readonly=\"1\" optional=\"show\"/>\n                <field name=\"transform_original_product_id\" readonly=\"1\" optional=\"hide\"/>\n                <field name=\"transform_invoice_id\" readonly=\"1\" optional=\"hide\"/>\n            </xpath>\n            <xpath expr=\"//field[@name='claim_line_ids']/form//field[@name='product_id']\" position=\"after\">\n                <field name=\"transform_id\" readonly=\"1\"/>\n                <field name=\"transform_original_product_id\" readonly=\"1\"/>\n                <field name=\"transform_invoice_id\" readonly=\"1\"/>\n            </xpath>\n        </data>"
