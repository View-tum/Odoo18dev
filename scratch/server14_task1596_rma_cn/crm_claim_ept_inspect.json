  "views": [
    {
      "id": 4533,
      "name": "CRM - Claims Ept Form",
      "type": "form",
      "inherit_id": false,
      "arch_excerpt": "<form string=\"Claim\">\n                <header>\n                    <button type=\"object\" name=\"action_rma_send\" class=\"oe_highlight\" string=\"Send RMA By Mail\" invisible=\"rma_send\"/>\n                    <button type=\"object\" name=\"action_rma_send\" string=\"Send RMA By Mail\" invisible=\"not rma_send\"/>\n                    <button type=\"object\" name=\"approve_claim\" string=\"Approve\" class=\"oe_highlight\" invisible=\"state != 'draft'\"/>\n                    <button type=\"object\" name=\"reject_claim\" string=\"Reject\" class=\"oe_highlight\" invisible=\"state != 'draft'\"/>\n                    <button type=\"object\" name=\"set_to_draft\" string=\"Set to Draft\" class=\"oe_highlight\" invisible=\"state not in ['approve','reject']\"/>\n                    <button type=\"object\" name=\"process_claim\" string=\"Validate\" class=\"oe_highlight\" invisible=\"state != 'process'\"/>\n                    <button type=\"object\" name=\"action_claim_reject_process_ept\" string=\"Reject\" class=\"oe_highlight\" invisible=\"state != 'process'\"/>\n                    <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"draft,approve,process,close\"/>\n                </header>\n                <sheet string=\"Claims\">\n                    <group name=\"invisible_fields\" invisible=\"1\">\n                        <field name=\"new_sale_id\"/>\n                        <field name=\"parent_partner_id\"/>\n                        <field name=\"refund_invoice_ids\"/>\n                        <field name=\"to_return_picking_ids\"/>\n                        <field name=\"rma_send\"/>\n                        <field name=\"internal_picking_id\"/>\n                        <field name=\"move_product_ids\"/>\n                        <field name=\"return_picking_id\"/>\n                        <field name=\"claim_lot_ids\"/>\n                    </group>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <button class=\"oe_stat_button\" name=\"show_return_picking\" type=\"object\" icon=\"fa-truck\" invisible=\"(return_picking_id == False) or (state in ['draft'])\">\n                            <field name=\"return_picking_count\" string=\"Receipt\" widget=\"statinfo\"/>\n                        </button>\n                        <button class=\"oe_stat_button\" name=\"show_delivery_picking\" type=\"object\" icon=\"fa-truck\" invisible=\"to_return_picking_ids == []\">\n                            <field name=\"delivery_picking_count\" string=\"Deliveries\" widget=\"statinfo\"/>\n                        </button>\n                        <button class=\"oe_stat_button\" name=\"act_supplier_invoice_refund_ept\" icon=\"fa-money\" type=\"object\" invisible=\"refund_invoice_ids == []\">\n                            <field name=\"refund_invoice_count\" string=\"Refund Invoices\" widget=\"statinfo\"/>\n                        </button>\n                        <button class=\"oe_stat_button\" name=\"act_new_so_ept\" type=\"object\" icon=\"fa-usd\" invisible=\"not new_sale_id\" context=\"{'so_id': new_sale_id}\">\n                            <span class=\"o_stat_text\">Sale Order</span>\n                        </button>\n                        <button class=\"oe_stat_button\" name=\"action_view_repair_orders\" icon=\"fa-wrench\" type=\"object\" invisible=\"repairs_count == 0\">\n                            <field name=\"repairs_count\" string=\"Repairs\" widget=\"statinfo\"/>\n                        </button>\n                    </div>\n                    <h1>\n                        <field name=\"code\" class=\"oe_inline\" readonly=\"1\"/>\n                    </h1>\n                    <group>\n                        <group readonly=\"state != 'draft'\">\n                            <field name=\"name\"/>\n                            <field name=\"user_id\" widget=\"many2one_avatar_user\"/>\n                            <field name=\"section_id\"/>\n                            <field name=\"is_rma_without_incoming\"/>\n                            <field name=\"rma_support_person_id\" domain=\"[('type', '=', 'contact'), ('parent_id', '=?', parent_partner_id)]\" options=\"{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}\"/>\n                        </group>\n                        <group>\n                            <field name=\"date\" readonly=\"state != 'draft'\"/>\n                            <field name=\"priority\" readonly=\"state != 'draft'\" widget=\"priority\"/>\n                            <field name=\"date_deadline\" readonly=\"state != 'draft'\"/>\n                            <button name=\"create_contact_partner\" type=\"object\" string=\"Add Contact Person\" invisible=\"state == 'close'\"/>\n                        </group>\n                    </group>\n                    <group>\n                        <field name=\"reject_message_id\" readonly=\"1\" invisible=\"state != 'reject'\" options=\"{&quot;no_open&quot;: True}\"/>\n                    </group>\n                    <notebook>\n                        <page string=\"RMA Details\" name=\"rma_details\">\n                            <group>\n                                <group>\n                                    <field name=\"picking_id\" context=\"{'rma_model': True}\" required=\"1\" readonly=\"state != 'draft'\" domain=\"['&amp;', ('picking_type_code', '=', 'outgoing'), '&amp;', ('state', '=', 'done'), '|', ('sale_id', '!=', False), ('rma_sale_id', '!=', False)]\" options=\"{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}\"/>\n                                    <field name=\"partner_id\" string=\"Partner\" required=\"1\" readonly=\"state != 'draft'\" options=\"{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}\"/>\n                                    <field name=\"email_from\" widget=\"email\" readonly=\"state != 'draft'\"/>\n                                    <field name=\"partner_delivery_id\" required=\"1\" domain=\"[('type', '=', 'delivery'), ('parent_id', '=?', parent_partner_id)]\" readonly=\"state != 'draft'\" options=\"{'no_quick_create': True,'no_create_edit': True,'no_open': True}\"/>\n                                </group>\n                                <group>\n                                    <field name=\"sale_id\" read"
    },
