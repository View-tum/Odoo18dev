<mxfile host="app.diagrams.net" agent="Codex Thai Flow" pages="8" modified="2026-06-17T13:08:38.558397Z">
  <diagram id="00-how-to-read-flow-th" name="00 วิธีอ่าน Flow"><mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="วิธีอ่าน Swimlane Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#5B1747;align=left;verticalAlign=middle;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1600" height="46" as="geometry" /></mxCell><mxCell id="3" value="ใช้หน้านี้อธิบายวิธีอ่าน diagram ก่อนเริ่ม present flow จริง" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1600" height="38" as="geometry" /></mxCell><mxCell id="4" value="1. อ่านจากซ้ายไปขวา" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="5" value="เริ่มที่กล่อง Start แล้วตามลูกศรไปทีละขั้น&#10;ถ้าเจอเส้นย้อนกลับ ให้มองว่าเป็น loop เช่น Rework หรือ Replenish&#10;อย่าข้าม Decision เพราะเป็นจุดที่ระบบแยกทางเลือก" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="6" value="2. อ่านตาม Swimlane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="7" value="แต่ละ lane คือเจ้าของงานหรือ module&#10;ถ้าลูกศรข้าม lane แปลว่ามี handoff ระหว่างแผนกหรือ Odoo app&#10;จุดข้าม lane คือจุดที่ควรถามเรื่อง owner, SLA และข้อมูลที่ต้องส่งต่อ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="8" value="3. ใช้สีและ Symbol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="9" value="เขียว = Start/End&#10;ฟ้า = Process มาตรฐาน Odoo&#10;เหลือง = Document เช่น SO/PO/MO/Invoice&#10;ม่วง = Database/Master Data&#10;แดง = Decision&#10;ส้ม = Custom หรือ Report Candidate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="10" value="4. แยก Standard vs Pain Point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="11" value="ถ้าเป็นกล่องฟ้าหรือเหลือง ให้เริ่มจาก Odoo Standard ก่อน&#10;ถ้าเป็นกล่องส้ม ให้ใช้เป็นรายการ workshop ต่อว่าต้อง custom จริงหรือเป็น config/report ได้&#10;หลักคือ Standard First, Custom Later" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="500" height="210" as="geometry" /></mxCell><mxCell id="12" value="5. อ่าน Decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="13" value="Decision คือจุดควบคุมธุรกิจ เช่น Approve?, QC Pass?, Buy or Make?&#10;ทุก Decision ต้องมีคำตอบชัดเจนว่าใครตัดสินใจ ใช้ข้อมูลอะไร และผลลัพธ์ไป flow ไหน" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="486" width="500" height="210" as="geometry" /></mxCell><mxCell id="14" value="6. อ่านผลกระทบ Stock/Accounting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="15" value="ทุกขั้นที่มี stock.move, valuation, WIP, FG, COGS, Invoice หรือ Payment ต้องระวัง Accounting &amp; Stock Integrity&#10;ห้ามออกแบบให้แก้ stock/cost/accounting ด้วย manual SQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="486" width="500" height="210" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="01-present-sequence-th" name="01 ลำดับ Present"><mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="ลำดับการ Present ตั้งแต่ต้นจนจบ" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#5B1747;align=left;verticalAlign=middle;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1600" height="46" as="geometry" /></mxCell><mxCell id="3" value="ใช้เป็น speaker guide ใน diagrams.net ก่อนเข้า flow ราย module" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1600" height="38" as="geometry" /></mxCell><mxCell id="4" value="1. เปิดด้วย Scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="5" value="บอกว่า diagram นี้แปลง Business Flow จาก Excel ไปเทียบกับ Odoo AMS DB&#10;เป้าหมายคือดูว่า Standard Odoo รองรับตรงไหน และ Pain Point ไหนต้อง custom/config/report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="6" value="2. อธิบาย Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="7" value="ใช้หน้า Symbol Legend อธิบายความหมายของสีและรูปทรง&#10;ย้ำว่าอ่านทุกหน้าแบบเดียวกันเพื่อไม่ให้ทีมตีความต่างกัน" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="8" value="3. Present Overall Flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="500" height="46" as="geometry" /></mxCell><mxCell id="9" value="พาอ่านภาพรวมจาก Customer Demand -&gt; Sales -&gt; MRP -&gt; Procurement/Manufacturing -&gt; Warehouse -&gt; Accounting -&gt; Management Reporting&#10;หน้านี้ใช้เพื่อให้ทุกฝ่ายเห็น End-to-End ก่อนลง module" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="196" width="500" height="210" as="geometry" /></mxCell><mxCell id="10" value="4. ลง Module ทีละหน้า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="11" value="เรียง Sales, Procurement, Warehouse, Manufacturing, Accounting, Planning&#10;ในแต่ละหน้าให้พูด Owner, Document, Decision, Standard Fit, Pain Point และ Data ที่ต้อง setup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="500" height="210" as="geometry" /></mxCell><mxCell id="12" value="5. สรุป Gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="13" value="รวมรายการที่ Odoo Standard มีแล้ว, ต้อง config, ต้อง report และอาจต้อง custom&#10;เน้นว่าทุก custom ต้องมีเหตุผลและไม่กระทบ Stock/Accounting Integrity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="486" width="500" height="210" as="geometry" /></mxCell><mxCell id="14" value="6. ปิดด้วย Next Step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B1747;strokeColor=#5B1747;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="500" height="46" as="geometry" /></mxCell><mxCell id="15" value="เสนอ workshop ตรวจ owner/data/master setup&#10;ยืนยัน module ที่ต้องเปิดใน AMS DB&#10;จัด priority custom candidate และกำหนด UAT scenario จาก flow นี้" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111827;fontSize=13;spacing=12;fontFamily=Arial;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="486" width="500" height="210" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="symbol-legend" name="02 คำอธิบายสัญลักษณ์">
