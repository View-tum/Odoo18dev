<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.ocr.local</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="account_ocr_settings" position="after">
                <setting string="Local OCR Setting" help="Configure the local self-hosted OCR microservice connection for scanned files and handwritten documents.">
                    <div class="content-group">
                        <div class="row">
                            <label for="local_ocr_enabled" class="col-lg-4 o_light_label"/>
                            <field name="local_ocr_enabled"/>
                        </div>
                        <div class="row mt8" invisible="not local_ocr_enabled">
                            <label for="local_ocr_server_url" class="col-lg-4 o_light_label"/>
                            <field name="local_ocr_server_url"/>
                        </div>
                        <div class="row mt8" invisible="not local_ocr_enabled">
                            <label for="local_ocr_timeout" class="col-lg-4 o_light_label"/>
                            <field name="local_ocr_timeout"/>
                        </div>
                        <div class="row mt8" invisible="not local_ocr_enabled">
                            <label for="local_ocr_confidence_threshold" class="col-lg-4 o_light_label"/>
                            <field name="local_ocr_confidence_threshold"/>
                        </div>
                        <div class="row mt8" invisible="not local_ocr_enabled">
                            <label for="local_ocr_replace_lines" class="col-lg-4 o_light_label"/>
                            <field name="local_ocr_replace_lines"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
    
